<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SAE.Views.Sale.DebtorView"
             x:Name="lblTitle">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Refresh" IconImageSource="ic_refresh" Clicked="btnRefresh_Clicked" x:Name="btnRefresh"/>
        <ToolbarItem Text="Save" IconImageSource="ic_add_circle" Clicked="btnAgregar_Clicked" x:Name="btnAgregar"/>
    </ContentPage.ToolbarItems>
    <StackLayout
        x:Name="stkMain">
        <StackLayout>
            <ActivityIndicator MaximumHeightRequest="20" x:Name="busyIndicator"/>
            <SearchBar 
                BackgroundColor="#512BD4"
                HeightRequest="20" 
                Placeholder="Buscar" 
                PlaceholderColor="White"
                TextColor="White"
                CancelButtonColor="White"
                TextChanged="searchBar_TextChanged"
                x:Name="searchBar"/>    
            <Grid 
                BackgroundColor="#512BD4"
                Padding="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.3*" />
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="0.8*" />
                </Grid.ColumnDefinitions>
                <Label 
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Text="Cliente"
                    TextColor="White"
                    FontAttributes="Bold" 
                    HorizontalOptions="Center"/>
                <Label Grid.Column="2"
                    Text="Fecha"
                    TextColor="White"
                    FontAttributes="Bold" 
                    HorizontalOptions="Center"/>
                <Label Grid.Column="3"
                    Text="Deuda"
                    TextColor="White"
                    FontAttributes="Bold" 
                    HorizontalOptions="Center"/>
            </Grid>
        </StackLayout>
        <ListView 
    HorizontalOptions="FillAndExpand"
    ItemSelected="lvDebtors_ItemSelected"
    x:Name="lvDebtors">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <Grid Padding="0"
                              BackgroundColor="{Binding BackgroundColor}"
                              VerticalOptions="FillAndExpand">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.3*" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="0.8*" />
                            </Grid.ColumnDefinitions>

                            <Label 
                                Grid.Column="0"
                                Grid.ColumnSpan="2"   
                                Text="{Binding CustomerName}"
                                TextColor="White"
                                FontAttributes="Bold"
                                Margin="5,0,0,0"
                                HorizontalOptions="Start"
                                VerticalTextAlignment="Center"/>
                            <Label Grid.Column="2"
                        Text="{Binding Date, StringFormat='{0:dd/MM/yyyy}'}"
                        TextColor="White"
                        FontAttributes="Bold" 
                           HorizontalOptions="Center"
                                   VerticalTextAlignment="Center"/>
                            <Label Grid.Column="3"
                        Text="{Binding Debt, StringFormat='{0:N2}'}"
                        TextColor="White"
                        FontAttributes="Bold" 
                           HorizontalOptions="Center"
                                   VerticalTextAlignment="Center"/>
                        </Grid>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackLayout>
</ContentPage>